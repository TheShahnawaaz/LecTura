{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "LecTura",
    "version": "../package.json"
  },
  "tauri": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/TheShahnawaaz/LecTura/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRjEwODg0MzZDQzkyMTcKUldRWGtzdzJoQWp4cXhUb1ZuVExVY01VSklDbWxsekt6aUVnZzVZMHNEMVc1NmlkYWFYdU52WGwK",
      "dialog": true
    },
    "allowlist": {
      "all": false,
      "fs": {
        "all": false
      },
      "protocol": {
        "asset": true,
        "assetScope": [
          "$APPDIR/**",
          "$APPDATA/**"
        ]
      },
      "shell": {
        "all": false,
        "open": true,
        "execute": false,
        "sidecar": false
      },
      "window": {
        "all": false,
        "setFullscreen": true
      }
    },
    "windows": [
      {
        "title": "LecTura",
        "width": 1200,
        "height": 800,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data: blob:; font-src 'self' data:; media-src 'self' asset: https://asset.localhost blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.lectura.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [
        "bin/yt-dlp"
      ]
    }
  }
}
